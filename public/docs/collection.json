    ],
    "info": {
        "name": "Laravel API Documentation",
        "_postman_id": "b8740768-901d-452c-8967-5d439d6d2660",
        "description": "",
        "schema": "https:\/\/schema.getpostman.com\/json\/collection\/v2.1.0\/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "description": "",
            "item": [
                {
                    "name": "Token Authentication",
                    "description": "",
                    "item": [
                        {
                            "name": "Register",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/register",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/register"
                                },
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\"name\":\"Jane Doe\",\"email\":\"jane@example.com\",\"password\":\"password123\",\"device_name\":\"ios-app\"}"
                                },
                                "description": "Create an account and issue its first bearer token. Use it once per new user; send an Idempotency-Key so a retried request cannot create a second account. Returns the user with the token, its type and expiry in meta, and sends a verification email.",
                                "auth": {
                                    "type": "noauth"
                                }
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 201,
                                    "body": "{\"data\":{\"id\":\"01m5cd9s04d0vrecpnz9vnq86a\",\"name\":\"Justina Gaylord\",\"email\":\"lafayette.considine@example.com\",\"email_verified_at\":\"2026-10-20T10:21:49+00:00\",\"created_at\":null,\"updated_at\":null},\"meta\":{\"token\":\"1|example-token\",\"token_type\":\"Bearer\",\"expires_at\":null}}",
                                    "name": "Registration succeeded."
                                },
                                {
                                    "header": [],
                                    "code": 422,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/validation-failed\",\"title\":\"Validation Failed\",\"status\":422,\"detail\":\"The email has already been taken.\",\"errors\":{\"email\":[\"The email has already been taken.\"]}}",
                                    "name": "Validation failed."
                                }
                            ]
                        },
                        {
                            "name": "Login",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/login",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/login"
                                },
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\"email\":\"jane@example.com\",\"password\":\"password123\",\"device_name\":\"ios-app\"}"
                                },
                                "description": "Exchange an email and password for a bearer token. Use it when a user signs in on a new device, naming the device in device_name. Returns the user with the token, its type and expiry in meta; wrong credentials are a 422 on the email field.",
                                "auth": {
                                    "type": "noauth"
                                }
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"data\":{\"id\":\"01m5cd9s0csvf155wbah7yn3s0\",\"name\":\"Justina Gaylord\",\"email\":\"cormier.nick@example.com\",\"email_verified_at\":\"2026-10-20T10:21:49+00:00\",\"created_at\":null,\"updated_at\":null},\"meta\":{\"token\":\"1|example-token\",\"token_type\":\"Bearer\",\"expires_at\":null}}",
                                    "name": "Login succeeded."
                                },
                                {
                                    "header": [],
                                    "code": 422,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/validation-failed\",\"title\":\"Validation Failed\",\"status\":422,\"detail\":\"The provided credentials are incorrect.\",\"errors\":{\"email\":[\"The provided credentials are incorrect.\"]}}",
                                    "name": "Credentials were invalid."
                                }
                            ]
                        },
                        {
                            "name": "Get Current User",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/me",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/me"
                                },
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Return the user the bearer token belongs to. Use it to check a token still works and to read the account's profile and verification state. The response carries an ETag: send it back in If-None-Match and an unchanged user returns 304 with no body."
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"data\":{\"id\":\"01m5cd9s12mhvc0tqhs163ps8h\",\"name\":\"Morgan Hirthe\",\"email\":\"dare.emelie@example.com\",\"email_verified_at\":\"2026-10-20T10:21:49+00:00\",\"created_at\":null,\"updated_at\":null}}",
                                    "name": "Authenticated user profile."
                                },
                                {
                                    "header": [],
                                    "code": 401,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/unauthorized\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\"}",
                                    "name": "Authentication failed."
                                }
                            ]
                        },
                        {
                            "name": "Logout",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/logout",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/logout"
                                },
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Revoke the bearer token that made this request, and only that one. Use it when a client signs out; the user's other tokens keep working. Returns 204 with no body."
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 204,
                                    "body": null,
                                    "name": "Token revoked."
                                },
                                {
                                    "header": [],
                                    "code": 401,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/unauthorized\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\"}",
                                    "name": "Authentication failed."
                                }
                            ]
                        },
                        {
                            "name": "List Tokens",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/tokens",
                                    "query": [
                                        {
                                            "key": "cursor",
                                            "value": "architecto",
                                            "description": "Opaque cursor from a Link header. Omit it for the first page.",
                                            "disabled": false
                                        }
                                    ],
                                    "raw": "{{baseUrl}}\/v1\/auth\/tokens?cursor=architecto"
                                },
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "List the authenticated user's personal access tokens, newest first, 25 to a page. Use it to show signed-in devices or to find a token ID to revoke. Returns an array of tokens, with is_current marking the one making the request; follow the Link header's rel=\"next\" for the next page."
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "[{\"id\":\"1\",\"name\":\"ios-app\",\"abilities\":[\"auth:me\",\"auth:logout\"],\"last_used_at\":null,\"expires_at\":\"2026-02-24T12:00:00+00:00\",\"created_at\":\"2026-02-23T12:00:00+00:00\",\"updated_at\":\"2026-02-23T12:00:00+00:00\",\"is_current\":true}]",
                                    "name": "One page of tokens, newest first. Navigation is in RFC 8288 Link headers: rel=\"next\" and rel=\"prev\" when there is a page that way, and rel=\"first\"."
                                },
                                {
                                    "header": [],
                                    "code": 401,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/unauthorized\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\"}",
                                    "name": "Authentication failed."
                                },
                                {
                                    "header": [],
                                    "code": 403,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/forbidden\",\"title\":\"Forbidden\",\"status\":403,\"detail\":\"Forbidden.\"}",
                                    "name": "Token is missing required ability."
                                }
                            ]
                        },
                        {
                            "name": "Revoke All Tokens",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/tokens",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/tokens"
                                },
                                "method": "DELETE",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Revoke every personal access token the authenticated user holds, including the one making this request. Use it to sign out everywhere after a suspected compromise. Returns 204 with no body; every later request with these tokens is a 401."
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 204,
                                    "body": null,
                                    "name": "All tokens revoked."
                                },
                                {
                                    "header": [],
                                    "code": 401,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/unauthorized\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\"}",
                                    "name": "Authentication failed."
                                },
                                {
                                    "header": [],
                                    "code": 403,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/forbidden\",\"title\":\"Forbidden\",\"status\":403,\"detail\":\"Forbidden.\"}",
                                    "name": "Token is missing required ability."
                                }
                            ]
                        },
                        {
                            "name": "Revoke Token",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/tokens\/:token_id",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/tokens\/:token_id",
                                    "variable": [
                                        {
                                            "id": "token_id",
                                            "key": "token_id",
                                            "value": 42,
                                            "description": "Personal access token id."
                                        }
                                    ]
                                },
                                "method": "DELETE",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Revoke one of the authenticated user's personal access tokens by its ID, such as a lost device's. Use List Tokens to find the ID. Returns 204 with no body; a token the user does not own, or that no longer exists, is a 404."
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 204,
                                    "body": null,
                                    "name": "Token revoked."
                                },
                                {
                                    "header": [],
                                    "code": 401,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/unauthorized\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\"}",
                                    "name": "Authentication failed."
                                },
                                {
                                    "header": [],
                                    "code": 403,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/forbidden\",\"title\":\"Forbidden\",\"status\":403,\"detail\":\"Forbidden.\"}",
                                    "name": "Token is missing required ability."
                                },
                                {
                                    "header": [],
                                    "code": 404,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/resource-not-found\",\"title\":\"Resource Not Found\",\"status\":404,\"detail\":\"Token not found.\"}",
                                    "name": "Token does not belong to current user or no longer exists."
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "Password Reset",
                    "description": "",
                    "item": [
                        {
                            "name": "Request Password Reset",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/password\/forgot",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/password\/forgot"
                                },
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\"email\":\"jane@example.com\"}"
                                },
                                "description": "Email a password reset link to an address, if an account uses it. Use it from a forgot-password form. The response is the same whether or not the account exists, so it cannot be used to discover accounts; send an Idempotency-Key so a retry does not send a second email.",
                                "auth": {
                                    "type": "noauth"
                                }
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"message\":\"If the account exists, a password reset link has been sent.\"}",
                                    "name": "Password reset request accepted."
                                },
                                {
                                    "header": [],
                                    "code": 422,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/validation-failed\",\"title\":\"Validation Failed\",\"status\":422,\"detail\":\"The email field must be a valid email address.\",\"errors\":{\"email\":[\"The email field must be a valid email address.\"]}}",
                                    "name": "The email was missing or not an email address."
                                },
                                {
                                    "header": [],
                                    "code": 429,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/rate-limit-exceeded\",\"title\":\"Rate Limit Exceeded\",\"status\":429,\"detail\":\"Too many requests. Please try again later.\"}",
                                    "name": "Too many reset requests for this address; retry after the Retry-After header."
                                }
                            ]
                        },
                        {
                            "name": "Reset Password",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/password\/reset",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/password\/reset"
                                },
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\"token\":\"reset-token-value\",\"email\":\"jane@example.com\",\"password\":\"new-password123\",\"password_confirmation\":\"new-password123\"}"
                                },
                                "description": "Set a new password using the token from a password reset email. Use it to finish the forgot-password flow. Returns a confirmation message; an invalid or expired token is a 422 on the email field.",
                                "auth": {
                                    "type": "noauth"
                                }
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"message\":\"Your password has been reset.\"}",
                                    "name": "Password reset succeeded."
                                },
                                {
                                    "header": [],
                                    "code": 422,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/validation-failed\",\"title\":\"Validation Failed\",\"status\":422,\"detail\":\"This password reset token is invalid.\",\"errors\":{\"email\":[\"This password reset token is invalid.\"]}}",
                                    "name": "Reset token or payload was invalid."
                                }
                            ]
                        },
                        {
                            "name": "Read Reset Token Payload",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/password\/reset\/:token",
                                    "query": [
                                        {
                                            "key": "email",
                                            "value": "jane@example.com",
                                            "description": "Account email from the reset link.",
                                            "disabled": false
                                        }
                                    ],
                                    "raw": "{{baseUrl}}\/v1\/auth\/password\/reset\/:token?email=jane%40example.com",
                                    "variable": [
                                        {
                                            "id": "token",
                                            "key": "token",
                                            "value": "reset-token-value",
                                            "description": "Password reset token from reset link."
                                        }
                                    ]
                                },
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Return the token and email from a password reset link, for a client that opens the link and shows its own reset form. It does not check the token; Reset Password does. Returns the token and the email, if the link carried one.",
                                "auth": {
                                    "type": "noauth"
                                }
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"token\":\"reset-token-value\",\"email\":\"jane@example.com\"}",
                                    "name": "Reset payload data."
                                },
                                {
                                    "header": [],
                                    "code": 422,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/validation-failed\",\"title\":\"Validation Failed\",\"status\":422,\"detail\":\"The email field must be a valid email address.\",\"errors\":{\"email\":[\"The email field must be a valid email address.\"]}}",
                                    "name": "The email query parameter was not an email address."
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "Email Verification",
                    "description": "",
                    "item": [
                        {
                            "name": "Verify Email",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/email\/verify\/:id\/:hash",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/email\/verify\/:id\/:hash",
                                    "variable": [
                                        {
                                            "id": "id",
                                            "key": "id",
                                            "value": "01HZX3W3T4J8Q57XNZD5BPHJ92",
                                            "description": "User ULID from the signed verification link."
                                        },
                                        {
                                            "id": "hash",
                                            "key": "hash",
                                            "value": "8c4f4370e5db9b5be6d0f4c95495f49f998fa32a",
                                            "description": "SHA-1 hash of the email from the signed verification link."
                                        }
                                    ]
                                },
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Mark the user's email as verified using the signed link from the verification email. Clients do not build this URL; they follow the one in the email, which expires. Returns a confirmation message; a link that is invalid, expired or altered is a 403.",
                                "auth": {
                                    "type": "noauth"
                                }
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"message\":\"Email verified successfully.\"}",
                                    "name": "Email was verified."
                                },
                                {
                                    "header": [],
                                    "code": 403,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/forbidden\",\"title\":\"Forbidden\",\"status\":403,\"detail\":\"Invalid verification link.\"}",
                                    "name": "Signed URL was invalid, expired, or mismatched."
                                }
                            ]
                        },
                        {
                            "name": "Send Verification Email",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "v1\/auth\/email\/verification-notification",
                                    "query": [],
                                    "raw": "{{baseUrl}}\/v1\/auth\/email\/verification-notification"
                                },
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Send the authenticated user a new email verification link. Use it when the first link expired or never arrived; it is limited to six requests a minute. Returns a message saying the link was sent, or that the email is already verified."
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"message\":\"Verification link sent.\"}",
                                    "name": "Verification email queued\/sent."
                                },
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\"message\":\"Email is already verified.\"}",
                                    "name": "User already verified."
                                },
                                {
                                    "header": [],
                                    "code": 401,
                                    "body": "{\"type\":\"https:\\\/\\\/apiguide.dev\\\/errors\\\/unauthorized\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\"}",
                                    "name": "Authentication failed."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "Authorization",
                "type": "string"
            }
        ]
    }
}